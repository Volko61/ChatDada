# Créez .env.local et renseignez la clé InferX côté serveur uniquement.
INFERX_API_KEY=
# Utilisée uniquement lors de l’indexation et des recherches RAG.
OPENROUTER_API_KEY=
# URL publique utilisée pour le canonical, le sitemap et les données structurées.
NEXT_PUBLIC_SITE_URL=https://votre-domaine.fr
